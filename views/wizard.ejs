<%- include('partials/header', { pageTitle: 'Pedoman & Panduan Kompetisi', activeNav: 'wizard' }) %>

<div class="container container-wide">
  <!-- WIZARD STEP HEADER -->
  <div style="margin-bottom: 2rem; text-align: center;">
    <div style="display: inline-flex; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;">
      <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--brand-primary); font-weight: 700; font-size: 0.95rem;">
        <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: var(--brand-primary); color: #0c0d0d; font-size: 0.85rem;">1</span>
        <span>Baca Pedoman & Regulasi</span>
      </div>
      <div style="color: var(--border-color); font-size: 1.25rem;">&rarr;</div>
      <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-muted); font-weight: 500; font-size: 0.95rem;">
        <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: var(--bg-card-subtle); border: 1px solid var(--border-color); color: var(--text-muted); font-size: 0.85rem;">2</span>
        <span>Formulir Pendaftaran</span>
      </div>
      <div style="color: var(--border-color); font-size: 1.25rem;">&rarr;</div>
      <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-muted); font-weight: 500; font-size: 0.95rem;">
        <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: var(--bg-card-subtle); border: 1px solid var(--border-color); color: var(--text-muted); font-size: 0.85rem;">3</span>
        <span>Aktivasi Akun GZCTF</span>
      </div>
    </div>
    <h1 style="font-size: 1.85rem; font-weight: 800; color: #ffffff;">Pedoman Resmi & Panduan Peserta</h1>
    <p style="color: var(--text-muted); max-width: 680px; margin: 0.5rem auto 0 auto; font-size: 0.9rem;">
      Wajib dibaca dan dipahami sebelum mendaftar. Seluruh peserta terikat pada regulasi etik, aturan whitelist AI, dan integritas kompetisi SCC::CTF 2026.
    </p>
  </div>

  <!-- TAB NAVIGASI WIZARD -->
  <div style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; flex-wrap: wrap;">
    <button type="button" class="tab-btn active" id="tabBtn1" data-tab="tab1">
      Tata Tertib & Regulasi Resmi
    </button>
    <button type="button" class="tab-btn" id="tabBtn2" data-tab="tab2">
      Panduan Persiapan Alat (Windows / Linux / HP)
    </button>
  </div>

  <!-- KONTEN TAB 1: REGULASI RESMI -->
  <div id="tab1" class="gz-card markdown-content" style="padding: 2.25rem; margin-bottom: 2rem;">
    <%- pedomanHtml %>
  </div>

  <!-- KONTEN TAB 2: PANDUAN TEKNIS -->
  <div id="tab2" class="gz-card markdown-content" style="padding: 2.25rem; margin-bottom: 2rem; display: none;">
    <%- panduanHtml %>
  </div>

  <!-- CHECKBOX PERSETUJUAN & TOMBOL LANJUT -->
  <div class="gz-card" style="padding: 1.75rem; text-align: center; border: 1px solid var(--brand-dark); background: linear-gradient(180deg, #181818, #141414);">
    <form action="/wizard/accept" method="POST" id="wizardForm">
      <label style="display: inline-flex; align-items: center; gap: 0.75rem; cursor: pointer; font-size: 0.95rem; font-weight: 500; color: #ffffff; text-align: left; max-width: 720px; user-select: none;">
        <input type="checkbox" name="agree" id="agreeCheckbox" required style="width: 20px; height: 20px; accent-color: var(--brand-primary); cursor: pointer;">
        <span>
          Saya telah membaca, memahami, dan <strong>berjanji mematuhi seluruh tata tertib</strong> kompetisi SCC::CTF 2026, termasuk regulasi whitelist AI gratis, larangan DoS/scanner, serta integritas penulisan laporan Writeup.
        </span>
      </label>

      <div style="margin-top: 1.5rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <button type="submit" id="btnNext" class="btn btn-primary" style="padding: 0.85rem 2.25rem; font-size: 1.05rem;" disabled>
          Lanjut ke Formulir Pendaftaran &rarr;
        </button>
      </div>
    </form>
  </div>
</div>

<style>
  .tab-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.925rem;
    font-weight: 600;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .tab-btn:hover {
    color: var(--text-main);
    background-color: var(--bg-card-subtle);
  }
  .tab-btn.active {
    color: var(--brand-primary);
    background-color: rgba(42, 229, 181, 0.12);
    border-bottom: 2px solid var(--brand-primary);
  }
  
  /* Markdown Content Styling */
  .markdown-content h1 {
    font-size: 1.65rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .markdown-content h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--brand-light);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.35rem;
  }
  .markdown-content h3 {
    font-size: 1.15rem;
    font-weight: 600;
    color: #ffffff;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .markdown-content h4 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--brand-primary);
    margin-top: 1.25rem;
    margin-bottom: 0.4rem;
  }
  .markdown-content p {
    margin-bottom: 1rem;
    color: var(--text-main);
    line-height: 1.6;
  }
  .markdown-content ul, .markdown-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--text-main);
    line-height: 1.6;
  }
  .markdown-content li {
    margin-bottom: 0.35rem;
  }
  .markdown-content hr {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 1.75rem 0;
  }
  .markdown-content blockquote {
    background-color: rgba(42, 229, 181, 0.08);
    border-left: 4px solid var(--brand-primary);
    padding: 0.85rem 1.25rem;
    margin-bottom: 1.25rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--brand-light);
  }
  .markdown-content code {
    font-family: var(--font-mono);
    background-color: var(--bg-input);
    border: 1px solid var(--border-color);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.875em;
    color: #38bdf8;
  }
  .markdown-content pre {
    background-color: #0d0d0d;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }
  .markdown-content pre code {
    background: transparent;
    border: none;
    padding: 0;
    color: #e2e8f0;
  }
  .markdown-content a {
    color: var(--brand-primary);
    text-decoration: underline;
  }
  .markdown-content a:hover {
    color: var(--brand-light);
  }
</style>

<%- include('partials/footer') %>
