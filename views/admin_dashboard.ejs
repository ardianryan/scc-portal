<%- include('partials/header', { pageTitle: 'Panel Kontrol Admin', activeNav: 'admin' }) %>

<div class="container container-wide">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: #ffffff;">Dashboard Panitia SCC::CTF</h1>
      <p style="color: var(--text-muted); font-size: 0.875rem;">Kelola sesi pendaftaran sekolah, monitor sinkronisasi GZCTF, dan rekap peserta.</p>
    </div>
    <div style="display: flex; gap: 0.75rem;">
      <a href="/admin/export" class="btn btn-primary">
        📊 Download Rekap Excel (.xlsx)
      </a>
      <a href="/admin/logout" class="btn btn-secondary">
        Logout
      </a>
    </div>
  </div>

  <% if (messages.success && messages.success.length > 0) { %>
    <div class="alert alert-success"><%= messages.success[0] %></div>
  <% } %>
  <% if (messages.error && messages.error.length > 0) { %>
    <div class="alert alert-error"><%= messages.error[0] %></div>
  <% } %>

  <!-- STATISTIK KARTU -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div class="gz-card" style="padding: 1.25rem;">
      <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Total Pendaftar</div>
      <div style="font-size: 2rem; font-weight: 700; color: var(--brand-primary);"><%= participants.length %></div>
      <div style="font-size: 0.75rem; color: var(--text-dim);">Peserta terdata di portal</div>
    </div>
    <div class="gz-card" style="padding: 1.25rem;">
      <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Total Tim</div>
      <div style="font-size: 2rem; font-weight: 700; color: #60a5fa;"><%= teams.length %></div>
      <div style="font-size: 0.75rem; color: var(--text-dim);">Tim terdaftar</div>
    </div>
    <div class="gz-card" style="padding: 1.25rem;">
      <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Internal SMANSAGE</div>
      <div style="font-size: 2rem; font-weight: 700; color: #34d399;">
        <%= participants.filter(p => p.category === 'internal').length %>
      </div>
      <div style="font-size: 0.75rem; color: var(--text-dim);">Siswa SMAN 1 Gedeg</div>
    </div>
    <div class="gz-card" style="padding: 1.25rem;">
      <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Luar Sekolah / Umum</div>
      <div style="font-size: 2rem; font-weight: 700; color: #fbbf24;">
        <%= participants.filter(p => p.category !== 'internal').length %>
      </div>
      <div style="font-size: 0.75rem; color: var(--text-dim);">Peserta eksternal</div>
    </div>
  </div>

  <!-- PENGATURAN SESI PENDAFTARAN -->
  <div class="gz-card" style="margin-bottom: 2rem;">
    <div class="gz-card-header">
      <div class="gz-card-title">⚙️ Konfigurasi Sesi Pendaftaran</div>
      <div class="gz-card-subtitle">Ubah mode kompetisi dan kriteria peserta sesuai instruksi panitia.</div>
    </div>

    <form action="/admin/settings" method="POST">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Status Pendaftaran (Override Manual)</label>
          <select name="is_open" class="form-control">
            <option value="1" <%= settings.is_open === '1' ? 'selected' : '' %>>🟢 Buka (Menerima Pendaftaran)</option>
            <option value="0" <%= settings.is_open === '0' ? 'selected' : '' %>>🔴 Tutup (Pendaftaran Dinonaktifkan)</option>
          </select>
          <div class="form-hint">Jika disetel Tutup, pendaftaran ditutup manual terlepas dari jadwal tanggal.</div>
        </div>
        <div class="form-group">
          <label class="form-label">Mode Kepesertaan</label>
          <select name="mode" class="form-control">
            <option value="individual" <%= settings.mode === 'individual' ? 'selected' : '' %>>Individu (1 Akun 1 Siswa)</option>
            <option value="team" <%= settings.mode === 'team' ? 'selected' : '' %>>Tim / Beregu</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">📅 Waktu Mulai Dibuka (Opsional)</label>
          <input type="datetime-local" name="reg_start_at" class="form-control" value="<%= settings.reg_start_at || '' %>">
          <div class="form-hint">Kosongkan jika ingin langsung dibuka sekarang tanpa batas awal.</div>
        </div>
        <div class="form-group">
          <label class="form-label">⏰ Waktu Batas Ditutup (Deadline Pendaftaran)</label>
          <input type="datetime-local" name="reg_end_at" class="form-control" value="<%= settings.reg_end_at || '' %>">
          <div class="form-hint">Pendaftaran otomatis terkunci jika waktu sekarang telah melewati batas ini.</div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Tingkat / Jenjang Peserta yang Dibuka</label>
          <% 
            const levels = (settings.allowed_levels || 'sma_ma,smk,mahasiswa,general').split(',');
          %>
          <div style="display: flex; gap: 1.25rem; flex-wrap: wrap; margin-top: 0.5rem; background: var(--bg-card-subtle); padding: 0.75rem 1rem; border-radius: 6px; border: 1px solid var(--border-color);">
            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.9rem;">
              <input type="checkbox" name="level_sma_ma" value="1" <%= levels.includes('sma_ma') ? 'checked' : '' %>>
              <span>🏫 SMA / MA</span>
            </label>
            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.9rem;">
              <input type="checkbox" name="level_smk" value="1" <%= levels.includes('smk') ? 'checked' : '' %>>
              <span>🛠️ SMK</span>
            </label>
            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.9rem;">
              <input type="checkbox" name="level_mahasiswa" value="1" <%= levels.includes('mahasiswa') ? 'checked' : '' %>>
              <span>🎓 Mahasiswa</span>
            </label>
            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.9rem;">
              <input type="checkbox" name="level_general" value="1" <%= levels.includes('general') ? 'checked' : '' %>>
              <span>🌐 Umum / Komunitas</span>
            </label>
          </div>
          <div class="form-hint">Pilih jenjang pendidikan yang diizinkan mendaftar kompetisi.</div>
        </div>
        <div class="form-group">
          <label class="form-label">Maksimal Anggota per Tim (Jika Mode Tim)</label>
          <input type="number" name="max_team_members" class="form-control" value="<%= settings.max_team_members || 3 %>" min="1" max="10">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Nama Event Kompetisi</label>
          <input type="text" name="event_name" class="form-control" value="<%= settings.event_name || 'Smansage Cybersecurity Competition 2026' %>">
        </div>
        <div class="form-group">
          <label class="form-label">Maksimal Kuota Pendaftar</label>
          <input type="number" name="max_quota" class="form-control" value="<%= settings.max_quota || 200 %>">
        </div>
      </div>

      <!-- PENGATURAN SMTP EMAIL -->
      <div class="form-section-title" style="margin-top: 1.5rem;">
        <span>Pengaturan SMTP Email Verifikasi & Tiket Peserta</span>
        <span class="badge <%= settings.email_enable === '1' ? 'badge-success' : 'badge-warning' %>">
          <%= settings.email_enable === '1' ? 'Email Aktif' : 'Email Nonaktif' %>
        </span>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Status Kirim Email Konfirmasi</label>
          <select name="email_enable" class="form-control">
            <option value="1" <%= settings.email_enable === '1' ? 'selected' : '' %>>🟢 Aktif (Kirim Tiket & Akun ke Email Peserta)</option>
            <option value="0" <%= settings.email_enable === '0' ? 'selected' : '' %>>🔴 Nonaktif (Jangan Kirim Email)</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">SMTP Host & Port</label>
          <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 0.5rem;">
            <input type="text" name="smtp_host" class="form-control" value="<%= settings.smtp_host || 'smtp.office365.com' %>" placeholder="Host (misal: smtp.office365.com)">
            <input type="number" name="smtp_port" class="form-control" value="<%= settings.smtp_port || 587 %>" placeholder="587">
          </div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">SMTP Username (Email Pengirim)</label>
          <input type="email" name="smtp_user" class="form-control" value="<%= settings.smtp_user || '' %>" placeholder="no-reply@sman1gedeg.sch.id">
        </div>
        <div class="form-group">
          <label class="form-label">SMTP Password</label>
          <input type="password" name="smtp_pass" class="form-control" autocomplete="new-password" placeholder="•••••••• (Kosongkan jika tidak ingin mengubah)">
          <div class="form-hint">Disimpan aman dalam database lokal (terenkripsi AES-256-GCM) atau dari file .env.</div>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Header Pengirim (Sender From)</label>
        <input type="text" name="smtp_from" class="form-control" value="<%= settings.smtp_from || 'Panitia SCC::CTF 2026 <no-reply@sman1gedeg.sch.id>' %>" placeholder="Panitia SCC::CTF <email@domain>">
      </div>

      <div style="text-align: right; margin-top: 1rem;">
        <button type="submit" class="btn btn-primary">
          💾 Simpan Pengaturan Sesi
        </button>
      </div>
    </form>
  </div>

  <!-- UBAH PASSWORD ADMIN -->
  <div class="gz-card" style="margin-bottom: 2rem;">
    <div class="gz-card-header">
      <div class="gz-card-title">🔐 Ganti Password Akun Panitia</div>
      <div class="gz-card-subtitle">Perbarui kata sandi login untuk administrator <strong><%= locals.admin ? locals.admin.username : 'admin' %></strong>.</div>
    </div>

    <form action="/admin/change-password" method="POST" style="max-width: 600px;">
      <div class="form-group">
        <label class="form-label">Password Lama <span class="req">*</span></label>
        <input type="password" name="old_password" class="form-control" placeholder="Masukkan kata sandi lama Anda" required>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Password Baru <span class="req">*</span></label>
          <input type="password" name="new_password" class="form-control" placeholder="Minimal 6 karakter" minlength="6" required>
        </div>
        <div class="form-group">
          <label class="form-label">Konfirmasi Password Baru <span class="req">*</span></label>
          <input type="password" name="confirm_password" class="form-control" placeholder="Ketik ulang password baru" minlength="6" required>
        </div>
      </div>
      <div style="margin-top: 1rem;">
        <button type="submit" class="btn btn-secondary">
          🔑 Perbarui Password Admin
        </button>
      </div>
    </form>
  </div>

  <!-- TABEL DATA PENDAFTAR -->
  <div class="gz-card">
    <div class="gz-card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;">
      <div>
        <div class="gz-card-title">📋 Rekapitulasi Peserta Terdaftar (<%= participants.length %>)</div>
        <div class="gz-card-subtitle">Data lengkap peserta dan status akun di platform GZCTF.</div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="gz-table">
        <thead>
          <tr>
            <th>No</th>
            <th>Nama Lengkap</th>
            <th>Kategori</th>
            <th>Sekolah / Instansi</th>
            <th>NISN / Kelas</th>
            <th>Kontak WhatsApp</th>
            <th>Email</th>
            <th>Username GZCTF</th>
            <th>Dokumen Identitas</th>
            <th>Status Akun</th>
            <th>Waktu Daftar</th>
          </tr>
        </thead>
        <tbody>
          <% if (participants.length === 0) { %>
            <tr>
              <td colspan="11" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                Belum ada peserta yang mendaftar.
              </td>
            </tr>
          <% } else { %>
            <% participants.forEach((p, idx) => { %>
              <tr>
                <td><%= idx + 1 %></td>
                <td>
                  <strong><%= p.full_name %></strong>
                  <% if (p.team_name) { %>
                    <br><span style="font-size: 0.75rem; color: var(--brand-primary);">Tim: <%= p.team_name %> (<%= p.is_team_leader ? 'Ketua' : 'Anggota' %>)</span>
                  <% } %>
                </td>
                <td>
                  <% if (p.category === 'internal') { %>
                    <span class="badge badge-success">SMANSAGE</span>
                  <% } else if (p.category === 'external_school') { %>
                    <span class="badge badge-info">Sekolah Lain</span>
                  <% } else { %>
                    <span class="badge badge-warning">Umum</span>
                  <% } %>
                </td>
                <td><%= p.institution %></td>
                <td>
                  <%= p.nisn_or_id || '-' %><br>
                  <small style="color: var(--text-muted);"><%= p.class_grade || '-' %></small>
                </td>
                <td>
                  <a href="https://wa.me/<%= p.phone_wa.replace(/[^0-9]/g, '').replace(/^0/, '62') %>" target="_blank" rel="noopener noreferrer" style="color: #34d399; text-decoration: none;">
                    <%= p.phone_wa %> ↗
                  </a>
                </td>
                <td><%= p.email %></td>
                <td>
                  <code style="color: var(--brand-light); font-family: var(--font-mono);"><%= p.username_gzctf %></code>
                </td>
                <td>
                  <% if (p.doc_url) { %>
                    <a href="<%= p.doc_url %>" target="_blank" rel="noopener noreferrer" class="badge badge-info" style="text-decoration: none; padding: 0.35rem 0.6rem;">
                      Lihat Berkas ↗
                    </a>
                  <% } else if (p.is_gedeg_verified) { %>
                    <span class="badge badge-success" title="Terverifikasi otomatis via Dapodik SMANSAGE">
                      ✓ Dapodik Terverifikasi
                    </span>
                  <% } else { %>
                    <span style="font-size: 0.75rem; color: var(--text-dim);">-</span>
                  <% } %>
                </td>
                <td>
                  <% if (p.gzctf_status === 'success') { %>
                    <span class="badge badge-success">Terkoneksi</span>
                  <% } else if (p.gzctf_status === 'pending') { %>
                    <span class="badge badge-warning">Pending</span>
                  <% } else { %>
                    <span class="badge badge-danger" title="<%= p.gzctf_error %>">Gagal</span>
                  <% } %>
                </td>
                <td style="font-size: 0.8rem; color: var(--text-dim);">
                  <%= new Date(p.created_at).toLocaleDateString('id-ID', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
